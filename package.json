{
  "name": "ai-front-desk",
  "version": "1.0.0",
  "private": true,
  "description": "B2B AI Front Desk & Patient Conversion CRM - Indore Poly Dental Clinic",
  "scripts": {
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "npm run build --prefix server",
    "build:client": "npm run build --prefix client",
    "build": "npm run build:server && npm run build:client",
    "seed": "npm run seed --prefix server",
    "reset-db": "npm run reset-db --prefix server",
    "tunnel": "npx --yes cloudflared tunnel --url http://localhost:5000"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
